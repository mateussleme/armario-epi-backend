# Copie para .env e ajuste. O .env fica fora do git (ver .gitignore).
#
# O servidor le tudo isto do ambiente (internal/database/connection.go). Sem as
# variaveis de SQL ele morre na largada com
# "strconv.Atoi: parsing \"\": invalid syntax", que e o SQL_PORT vazio.
#
# Pelo VS Code, o launch.json ja aponta para o .env. No PowerShell, use o
# run-local.ps1.

SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB=epi

# Hardware do armario. Vazio roda sem: os cadastros, a solicitacao e a separacao
# funcionam normal; o que nao anda e abrir porta e contar as tags RFID.
RFID_CONTROLLER=
DOOR_PORTS=
DOOR_STATES=
SENSOR_PORTS=
SENSOR_STATES=
